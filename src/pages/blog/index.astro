---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title={`${SITE_TITLE} – Blog`} description="Poradniki, narzędzia i strategie dla gospodarzy najmu krótkoterminowego.">
  <section class="mx-auto max-w-6xl px-4 py-16 md:px-8">
    <h1>Blog</h1>
    <p class="mt-4 text-lg text-text-muted">
      Praktyczne poradniki dla gospodarzy najmu krótkoterminowego.
    </p>

    {posts.length === 0 ? (
      <p class="mt-8 text-text-muted">Brak wpisów.</p>
    ) : (
      <div class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <a
            href={`/blog/${post.id}/`}
            class="group block rounded-xl border border-secondary-dark bg-secondary p-6 transition-shadow hover:shadow-lg"
          >
            <time class="text-xs font-semibold uppercase tracking-wide text-accent">
              {post.data.pubDate.toLocaleDateString('pl-PL', {
                day: 'numeric',
                month: 'long',
                year: 'numeric',
              })}
            </time>
            <h3 class="mt-3 text-primary group-hover:text-accent transition-colors">
              {post.data.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-text-muted">{post.data.description}</p>
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-2">
                {post.data.tags.map((tag: string) => (
                  <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
    )}
  </section>
</Layout>
