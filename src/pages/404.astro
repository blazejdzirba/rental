---
import Layout from '../layouts/Layout.astro';
import { NAME } from '../consts';
---

<Layout title="404" description="Page not found.">
  <section class="container-prose py-24 text-center">
    <p class="mono-label">404</p>
    <h1 class="mt-4">Page not found</h1>
    <p class="lead mt-2">The page you're looking for doesn't exist or has been moved.</p>
    <a href="/" class="btn mt-8">Go home</a>
  </section>
</Layout>
