---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not found" description="This page does not exist." noindex>
  <section class="site-shell empty-state">
    <p class="eyebrow" style="justify-content: center;">
      <span class="eyebrow-num">404</span>
      <span>Missing</span>
    </p>
    <h1 style="margin: 0.75rem 0;">Nothing here.</h1>
    <p>The page you’re looking for moved, or never existed.</p>
    <div style="margin-top: 1.5rem; display: flex; justify-content: center; gap: 0.5rem;">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn btn-ghost" href="/explore/">Explore</a>
    </div>
  </section>
</Layout>
