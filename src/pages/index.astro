---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout title="Strona główna">
  <section class="bg-secondary text-center">
    <div class="mx-auto max-w-3xl px-4 py-24 md:px-8 md:py-32">
      <h1>Nazwa Twojej Strony</h1>
      <p class="mt-6 text-lg text-text/80">
        Praktyczne poradniki dla gospodarzy najmu krótkoterminowego.
      </p>
      
        href="/blog"
        class="mt-8 inline-block rounded-full bg-primary px-8 py-3 font-semibold text-white transition-colors hover:bg-primary-light"
      >
        Zobacz poradniki
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 md:px-8">
    <h2 class="mb-10 text-center">Najnowsze wpisy</h2>

    <div class="grid gap-8 md:grid-cols-3">
      {posts.map((post) => (
        
          href={`/blog/${post.slug}`}
          class="block rounded-lg border border-secondary-dark bg-secondary p-6 transition-shadow hover:shadow-lg"
        >
          <time class="text-xs uppercase tracking-wide text-accent">
            {post.data.pubDate.toLocaleDateString('pl-PL', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })}
          </time>
          <h3 class="mb-2 mt-3 text-primary">{post.data.title}</h3>
          <p class="text-sm text-text/80">{post.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>