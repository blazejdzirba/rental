---
import type { Entry } from '../lib/entries';
import { entryHref, formatDate, ownershipOf, padIndex, typeShort } from '../lib/entries';

interface Props {
  entry: Entry;
  index?: number;
}

const { entry, index } = Astro.props;
const { data } = entry;
const own = ownershipOf(entry);
const href = entryHref(entry);
---

<article class="entry-card">
  <div class="entry-card-top">
    <div class="entry-card-meta">
      {
        typeof index === 'number' && (
          <span class="entry-card-index" aria-hidden="true">
            {padIndex(index)}
          </span>
        )
      }
      <span class="chip chip-accent">{typeShort(data.type)}</span>
      <span class={`chip ${own === 'mine' ? 'chip-mine' : 'chip-found'}`}>
        {own === 'mine' ? 'My work' : 'Found'}
      </span>
    </div>
    <time class="entry-date" datetime={data.date.toISOString()}>
      {formatDate(data.date)}
    </time>
  </div>

  <h3 class="entry-card-title">
    <a href={href}>{data.title}</a>
  </h3>

  <p class="entry-card-desc">{data.description}</p>

  {
    data.image && (
      <a href={href} class="entry-card-media" tabindex="-1" aria-hidden="true">
        <img src={data.image} alt="" loading="lazy" />
      </a>
    )
  }

  {
    data.tags.length > 0 && (
      <div class="entry-card-tags">
        {data.tags.slice(0, 4).map((t) => (
          <span class="chip">{t}</span>
        ))}
      </div>
    )
  }
</article>
