---
import { TYPE_META, type ContentType } from '../consts';

interface Props {
  current?: ContentType | 'all';
  base?: string;
  counts?: Partial<Record<ContentType | 'all', number>>;
}

const { current = 'all', base = '/explore', counts } = Astro.props;

const SHORT_FILTER: Record<ContentType, string> = {
  project: 'Projects',
  github: 'GitHub',
  post: 'Posts',
  tutorial: 'Tutorials',
  resource: 'Resources',
  video: 'Videos',
};

const items: { id: ContentType | 'all'; label: string; href: string }[] = [
  { id: 'all', label: 'All', href: `${base}/` },
  ...(Object.keys(TYPE_META) as ContentType[]).map((t) => ({
    id: t as ContentType | 'all',
    label: SHORT_FILTER[t],
    href: `${base}/${t === 'project' ? 'projects' : t === 'post' ? 'posts' : t === 'tutorial' ? 'tutorials' : t === 'resource' ? 'resources' : t === 'github' ? 'github' : 'videos'}/`,
  })),
];
---

<nav class="filter-bar" aria-label="Filter by type">
  {
    items.map((item) => {
      const count = counts?.[item.id];
      const active = current === item.id;
      return (
        <a href={item.href} aria-current={active ? 'page' : undefined} class={active ? 'is-active' : undefined}>
          {item.label}
          {typeof count === 'number' && <span style="opacity:0.55; margin-left: 0.25rem;">{count}</span>}
        </a>
      );
    })
  }
</nav>
