---
const links = [
  { href: '/', label: 'Strona główna' },
  { href: '/blog', label: 'Blog' },
  { href: '/kursy', label: 'Kursy' },
  { href: '/programy', label: 'Programy' },
  { href: '/o-mnie', label: 'O mnie' },
  { href: '/kontakt', label: 'Kontakt' },
];
---

<header class="sticky top-0 z-50 bg-primary text-white shadow-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 md:px-8">
    <a href="/" class="font-heading text-xl font-bold tracking-wide">
      Nazwa Twojej Strony
    </a>

    <ul class="hidden md:flex md:items-center md:gap-8">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-sm font-medium uppercase tracking-wide hover:text-accent"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <button id="menu-toggle" class="md:hidden" aria-label="Otwórz menu" aria-expanded="false">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path id="icon-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        <path id="icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <ul id="mobile-menu" class="hidden flex-col gap-1 border-t border-white/10 px-4 pb-4 md:hidden">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          class="block py-2 text-sm font-medium uppercase tracking-wide hover:text-accent"
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const nowHidden = menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!nowHidden));
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });
</script>