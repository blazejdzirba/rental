---
import { TYPE_META, type ContentType } from '../consts';

interface Props {
  type: ContentType;
  ownership?: 'mine' | 'found';
  showOwnership?: boolean;
}

const { type, ownership, showOwnership = true } = Astro.props;
const meta = TYPE_META[type];
const own = ownership ?? meta.ownership;
---

<span class="entry-meta">
  <span class={`chip chip-accent`}>{meta.short}</span>
  {
    showOwnership && (
      <span class={`chip ${own === 'mine' ? 'chip-mine' : 'chip-found'}`}>
        {own === 'mine' ? 'My work' : 'Found'}
      </span>
    )
  }
</span>
