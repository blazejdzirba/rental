---
import { SITE_TITLE, AUTHOR, NAV } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-shell footer-inner">
    <div class="footer-meta">
      <div>
        <strong style="color: var(--color-fg); font-weight: 500;">{SITE_TITLE}</strong>
        <span aria-hidden="true"> — </span>
        a personal corner for building &amp; finding.
      </div>
      <div>© {year}{AUTHOR.name ? ` · ${AUTHOR.name}` : ''}</div>
    </div>
    <ul class="footer-links">
      {NAV.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
      <li><a href="/rss.xml">RSS</a></li>
      {AUTHOR.github && (
        <li>
          <a href={AUTHOR.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        </li>
      )}
    </ul>
  </div>
</footer>
