---
import Layout from './Layout.astro';
import CodeCopy from '../components/CodeCopy.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import type { Entry } from '../lib/entries';
import {
  formatDate,
  ownershipOf,
  typeShort,
  entryHref,
} from '../lib/entries';
import { TYPE_META } from '../consts';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const { data } = entry;
const own = ownershipOf(entry);
const meta = TYPE_META[data.type];
---

<Layout
  title={data.title}
  description={data.description}
  image={data.image}
  type="article"
>
  <article class="site-shell" style="padding-block: 2.5rem 4rem;">
    <header class="prose-width" style="margin-bottom: 2.5rem;">
      <p class="eyebrow">
        <span class="eyebrow-num">{typeShort(data.type)}</span>
        <span aria-hidden="true">/</span>
        <span>{own === 'mine' ? 'My work' : 'Found'}</span>
      </p>

      <h1 style="margin: 0.75rem 0 1rem;">{data.title}</h1>

      <p class="lead" style="margin: 0 0 1.25rem;">{data.description}</p>

      <div class="entry-meta" style="margin-bottom: 0;">
        <time class="entry-date" datetime={data.date.toISOString()}>
          {formatDate(data.date)}
        </time>
        {
          data.updated && (
            <span class="entry-date">
              Updated {formatDate(data.updated)}
            </span>
          )
        }
        {data.readingTime && <span class="entry-date">{data.readingTime}</span>}
        {data.duration && <span class="entry-date">{data.duration}</span>}
        {
          data.author && own === 'found' && (
            <span class="entry-date">
              by{' '}
              {data.authorUrl ? (
                <a class="link-quiet" href={data.authorUrl} target="_blank" rel="noopener noreferrer">
                  {data.author}
                </a>
              ) : (
                data.author
              )}
            </span>
          )
        }
      </div>

      {
        data.tags.length > 0 && (
          <div style="margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.4rem;">
            {data.tags.map((t) => (
              <a
                class="chip"
                href={`/explore/tag/${t.toLowerCase().replace(/\s+/g, '-')}/`}
              >
                {t}
              </a>
            ))}
          </div>
        )
      }
    </header>

    {
      data.image && (
        <figure class="content-width" style="margin: 0 0 2.5rem;">
          <img
            src={data.image}
            alt={data.imageAlt || data.title}
            style="width: 100%; border-radius: var(--radius-md); border: 1px solid var(--color-border);"
          />
        </figure>
      )
    }

    {
      (data.videoUrl || data.videoFile) && (
        <div class="content-width" style="margin-bottom: 2rem;">
          <VideoEmbed videoUrl={data.videoUrl} videoFile={data.videoFile} title={data.title} />
        </div>
      )
    }

    {
      /* External links strip */
      (data.github || data.demo || data.url) && (
        <div
          class="prose-width"
          style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem;"
        >
          {data.github && (
            <a class="btn btn-ghost" href={data.github} target="_blank" rel="noopener noreferrer">
              GitHub →
            </a>
          )}
          {data.demo && (
            <a class="btn btn-ghost" href={data.demo} target="_blank" rel="noopener noreferrer">
              Demo →
            </a>
          )}
          {data.url && !data.demo && (
            <a class="btn btn-ghost" href={data.url} target="_blank" rel="noopener noreferrer">
              Visit →
            </a>
          )}
        </div>
      )
    }

    {
      data.why && (
        <aside class="prose-width callout" style="margin-bottom: 2rem;">
          <div class="callout-label">Why I like it</div>
          <p>{data.why}</p>
        </aside>
      )
    }

    {
      data.install && (
        <aside class="prose-width callout" style="margin-bottom: 2rem;">
          <div class="callout-label">Install</div>
          <div class="prose">
            <pre><code>{data.install}</code></pre>
          </div>
        </aside>
      )
    }

    {
      own === 'found' && (
        <p
          class="prose-width"
          style="font-size: 0.8125rem; color: var(--color-fg-subtle); margin-bottom: 2rem; padding: 0.75rem 1rem; border-left: 2px solid var(--color-found);"
        >
          This is a project I found and recommend — I am not the author
          {data.author ? ` (${data.author})` : ''}.
          {data.github && (
            <>
              {' '}
              Original source:{' '}
              <a class="link-quiet" href={data.github} target="_blank" rel="noopener noreferrer">
                repository
              </a>
              .
            </>
          )}
        </p>
      )
    }

    <div class="prose prose-width">
      <slot />
    </div>

    <footer
      class="prose-width"
      style="margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border);"
    >
      <a class="link-arrow" href="/explore/">
        <span class="arrow" aria-hidden="true">←</span>
        Back to explore
      </a>
    </footer>
  </article>

  <CodeCopy />
</Layout>
