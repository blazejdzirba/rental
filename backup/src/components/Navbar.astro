---
import { NAV, CTA_MAIN } from '../consts';
---

<header class="sticky top-0 z-50 border-b border-line bg-secondary/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 md:px-8">
    <!-- Logo: złoty kwadrat z inicjałem "B" + nazwa marki -->
    <a href="/" class="flex items-center gap-2">
      <span class="flex h-8 w-8 items-center justify-center rounded bg-accent-light font-heading text-lg font-bold text-primary-dark">B</span>
      <span class="font-heading text-lg font-bold text-primary">Najem KŚ</span>
    </a>

    <!-- Menu desktop -->
    <ul class="hidden md:flex md:items-center md:gap-6">
      {NAV.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-sm font-medium uppercase tracking-wide text-primary hover:text-accent"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA + hamburger (mobile) -->
    <div class="flex items-center gap-3">
      <a href={CTA_MAIN.href} class="btn-gold hidden rounded px-4 py-2 text-sm font-semibold md:inline-block">
        {CTA_MAIN.label}
      </a>
      <button id="menu-toggle" class="md:hidden" aria-label="Otwórz menu" aria-expanded="false">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path id="icon-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          <path id="icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Menu mobilne -->
  <ul id="mobile-menu" class="hidden flex-col gap-1 border-t border-line bg-secondary px-4 pb-4 md:hidden">
    {NAV.map((link) => (
      <li>
        <a
          href={link.href}
          class="block py-2 text-sm font-medium uppercase tracking-wide text-primary hover:text-accent"
        >
          {link.label}
        </a>
      </li>
    ))}
    <li class="mt-2">
      <a href={CTA_MAIN.href} class="btn-gold block rounded px-4 py-2 text-center text-sm font-semibold">
        {CTA_MAIN.label}
      </a>
    </li>
  </ul>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const nowHidden = menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!nowHidden));
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });
</script>
