---
import { NAV, CONTACT } from '../consts';
const year = new Date().getFullYear();
---

<footer class="bg-primary text-white">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-3 md:px-8">
    <!-- Kolumna 1: O platformie -->
    <div>
      <h3 class="mb-3 font-heading text-lg font-semibold text-white">O platformie</h3>
      <p class="text-sm text-white/70">
        Praktyczne poradniki, kursy i narzędzia AI dla gospodarzy najmu krótkoterminowego. Automatyzacja, Beds24, systemy operacyjne.
      </p>
    </div>

    <!-- Kolumna 2: Nawigacja -->
    <div>
      <h3 class="mb-3 font-heading text-lg font-semibold text-white">Nawigacja</h3>
      <ul class="space-y-2 text-sm text-white/70">
        {NAV.map((link) => (
          <li>
            <a href={link.href} class="hover:text-accent">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Kolumna 3: Kontakt -->
    <div>
      <h3 class="mb-3 font-heading text-lg font-semibold text-white">Kontakt</h3>
      <ul class="space-y-2 text-sm text-white/70">
        {CONTACT.telegram && CONTACT.telegram !== '{{DO_UZUPEŁNIENIA}}' ? (
          <li>
            <a href={CONTACT.telegram} class="hover:text-accent" target="_blank" rel="noopener">
              Telegram →
            </a>
          </li>
        ) : null}
        {CONTACT.email && CONTACT.email !== '{{DO_UZUPEŁNIENIA}}' ? (
          <li>
            <a href={`mailto:${CONTACT.email}`} class="hover:text-accent">
              {CONTACT.email}
            </a>
          </li>
        ) : null}
        {(!CONTACT.telegram || CONTACT.telegram === '{{DO_UZUPEŁNIENIA}}') && (!CONTACT.email || CONTACT.email === '{{DO_UZUPEŁNIENIA}}') ? (
          <li class="text-white/40 italic">Dane kontaktowe w przygotowaniu</li>
        ) : null}
      </ul>
    </div>
  </div>

  <!-- Pasek dolny z granatowym tłem + złoty separator -->
  <div class="border-t-2 border-accent bg-primary-dark py-6 text-center text-xs text-white/50">
    © {year} Najem KŚ. Wszelkie prawa zastrzeżone.
  </div>
</footer>
